generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Difficulty {
  EASY
  MEDIUM
  HARD
}

enum QuestType {
  DAILY
  WEEKLY
}

enum QuestStatus {
  ACTIVE
  CLAIMED
  EXPIRED
}

model User {
  id    String  @id @default(cuid())
  name  String?
  email String? @unique

  level   Int @default(1)
  xp      Int @default(0)
  life    Int @default(10)
  maxLife Int @default(10)
  gold    Int @default(0)

  streakCount        Int       @default(0)
  lastCompletionDate DateTime?

  tasksCompletedTotal Int @default(0)

  avatarUrl String?
  inventory InventoryItem[]

  lastInactivityPenaltyAt DateTime?

  tasks Task[]

  createdAt    DateTime          @default(now())
  updatedAt    DateTime          @updatedAt
  achievements UserAchievement[]
  quests       Quest[]
}

model Task {
  id         String     @id @default(cuid())
  title      String
  difficulty Difficulty @default(EASY)

  dueDate     DateTime?
  completed   Boolean   @default(false)
  completedAt DateTime?

  dayKey String

  overdueProcessedAt DateTime?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum ItemType {
  POTION_SMALL
  POTION_MEDIUM
  POTION_LARGE
}

model Quest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type   QuestType
  status QuestStatus @default(ACTIVE)

  code        String
  title       String
  description String

  target   Int
  progress Int @default(0)

  rewardXp   Int @default(0)
  rewardGold Int @default(0)

  dayKey String?

  weekKey String?

  claimedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@unique([userId, code, dayKey])
  @@unique([userId, code, weekKey])
  @@index([userId, dayKey])
  @@index([userId, weekKey])
}

model Item {
  id        String   @id @default(cuid())
  type      ItemType @unique
  name      String
  price     Int // em gold
  healValue Int // quanto cura

  inventory InventoryItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model InventoryItem {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  itemId String
  item   Item   @relation(fields: [itemId], references: [id], onDelete: Cascade)

  quantity Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, itemId]) // ✅ 1 linha por item por usuário
}

enum AchievementType {
  TASKS_COMPLETED_TOTAL
  STREAK_REACHED
  GOLD_REACHED
  LEVEL_REACHED
}

model Achievement {
  id          String          @id @default(cuid())
  code        String          @unique // ex: "FIRST_TASK"
  title       String
  description String
  type        AchievementType

  // condição (um número alvo)
  target Int

  // recompensa
  rewardGold Int @default(0)
  rewardXp   Int @default(0)

  users UserAchievement[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model UserAchievement {
  id            String   @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime @default(now())

  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievement Achievement @relation(fields: [achievementId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
}
